# Local only — never commit real keys.
# The chatbot API route reads GEMINI_API_KEY at runtime.
# Get a free key at https://aistudio.google.com — paste it below, restart `npm run dev`.
GEMINI_API_KEY=
# Optional model pin (defaults to gemini-3.5-flash-lite). If /api/chat returns the
# refusal for everything, check the live model list and set this.
GEMINI_MODEL=gemini-3.5-flash-lite
